# Shell scripts keep LF line endings on every system
*.sh text eol=lf
# Binary files: never convert or diff as text
*.pkl binary
*.ipt binary
*.iam binary
*.docx binary
*.xlsx binary
*.png binary
*.pdf binary
*.slx binary
*.mat binary
*.fig binary
# OpenSim package: keep every file byte-for-byte as delivered (no line-ending conversion)
opensim/** -text
